# Everything here is OPTIONAL — the defaults below are what you get with no .env / no Portainer variables.
# Change the passwords before the store is reachable from the internet. Never commit .env.

# --- Database (defaults: admin / admin) ---
DB_USER=admin
DB_PASS=admin
DB_ROOT_PASS=admin

# --- First-run admin panel login (you are forced to choose a new password on first sign-in) ---
ADMIN_USER=admin
ADMIN_PASS=admin

# Random 32+ character string (openssl rand -hex 32). Encrypts the Byabsayee link secrets. Set BEFORE pairing; never change later.
ERP_SECRET_KEY=

# --- Web ---
WEB_PORT=8080
# The public address customers use (https://shop.example.com). Needed for links in emails and link previews.
# Can also be set later in Admin -> Store settings -> Details & email.
SITE_URL=
TZ=Asia/Dhaka
APP_DEBUG=0

# --- Optional (the setup wizard and admin panel can change all of these later) ---
DB_NAME=store_db
PMA_PORT=8081
# STORE_IMAGE=ghcr.io/<your-account>/online-store:latest
SITE_NAME=Online Store
CURRENCY_SYMBOL=৳
CURRENCY_CODE=BDT
CONTACT_EMAIL=
# SMTP for order / password emails (or set it in the admin panel):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Google sign-in (optional):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
