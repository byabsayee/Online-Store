# Copy this file to .env and adjust values before running docker compose.
# `cp .env.example .env`

# --- Web ---
WEB_PORT=1023
SITE_NAME="Kafeel (كَفِيلْ)"
# Public address of the store, e.g. https://kafeelshopbd.com -- used for links inside
# emails (verify email, reset password, order tracking), the sitemap and link previews
# (WhatsApp/Facebook need the real https address). Can also be set in
# Admin -> Settings & email -> Public site address, which overrides this.
# Set it to the address customers ACTUALLY use today, not one you plan to buy.
SITE_URL=
CURRENCY_SYMBOL=৳
CURRENCY_CODE=BDT

# --- Shipping ---
SHIPPING_INSIDE_DHAKA_FEE=80
SHIPPING_SUBURBS_FEE=100
SHIPPING_OUTSIDE_DHAKA_FEE=130
SHIPPING_FREE_WEIGHT_KG=1
SHIPPING_EXTRA_PER_KG=20
DELIVERY_DAYS_MIN=3
DELIVERY_DAYS_MAX=5

# --- Contact / social ---
CONTACT_EMAIL=hello@kafeelshopbd.com
CONTACT_PHONE=
CONTACT_PHONE_2=
# Printed on invoices. Can also be edited later in Admin -> Settings & email.
STORE_ADDRESS=
SOCIAL_FACEBOOK=https://www.facebook.com/kafeelshopbd
SOCIAL_FACEBOOK_MESSENGER=https://www.m.me/kafeelshopbd
SOCIAL_INSTAGRAM=https://www.instagram.com/kafeelbd/
SOCIAL_YOUTUBE=https://www.youtube.com/@Kafeelbd
SOCIAL_WHATSAPP=

# --- Outbound email (PHPMailer). You can ALSO set all of this from the admin
# panel (Settings & email) -- values saved there override these. Leave
# SMTP_HOST blank to fall back to
# PHP's mail() function -- fine for a quick test, but most hosts (Gmail,
# Zoho, your registrar's mail server, etc.) need real SMTP creds to
# actually deliver mail reliably. Used for: contact form, email
# verification, password reset, order confirmation / status emails and promotional
# emails. The From address should be the login address (Gmail, Zoho and Outlook
# refuse anything else). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=hello@kafeelshopbd.com
SMTP_FROM_NAME="Kafeel"

# --- Google sign-in (optional). Can ALSO be set in Admin -> Settings & email -> Google
# sign-in; values saved there override these. Needs an https:// domain (see README). ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TZ=Asia/Dhaka
APP_DEBUG=0

# --- Database (MariaDB) ---
DB_NAME=kafeel_db
DB_USER=admin
DB_PASS=ChangeMe123!
DB_ROOT_PASS=ChangeMe123!

# --- phpMyAdmin (bundled DB UI, logs in with DB_USER / DB_PASS above) ---
PMA_PORT=1024

# --- Accounting integration (Byabsayee) -----------------------------------
# Optional but recommended in production: key material used to encrypt the
# integration's stored API key and secrets. Leave empty to derive it from the
# app secret. Changing it later means re-pairing the link.
ERP_SECRET_KEY=
